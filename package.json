{
  "name": "dsh-imagestudio",
  "version": "0.2.0",
  "description": "DSH Image Studio — skill-compiled creative plans, multi-provider generation, assets, and compose for DeepSeek Harness.",
  "type": "module",
  "main": "./plugin.ts",
  "exports": {
    ".": "./plugin.ts",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./client": "./packages/client/lib/client.js",
    "./core": "./packages/core/src/index.ts",
    "./tools": "./packages/tools/src/index.ts"
  },
  "files": [
    "plugin.ts",
    "index.ts",
    "cordis.patch.yml",
    "packages",
    "skills",
    "examples",
    "docs",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CONTRIBUTING.md"
  ],
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "test:ci": "node --test --experimental-strip-types tests/*.test.ts",
    "accept": "node --experimental-strip-types scripts/accept.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "patch:web": "node scripts/gen-dsh-patch.mjs",
    "build:client": "node node_modules/tsdown/dist/run.mjs -c packages/client/tsdown.config.ts",
    "build": "echo 'Type-strip ESM; Node 22.19+/24 loads .ts via --experimental-strip-types / dsh loader.'"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-tool"
      ],
      "external": [
        "react",
        "react/jsx-runtime"
      ],
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/schemastery": ">=3.18.1 <4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "image-generation",
    "cordis"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kim1232aa/dsh_imagestudio.git"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^22.20.2",
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "tsdown": "^0.23.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "jpeg-js": "^0.4.4"
  }
}
